---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LegalContact from '../components/LegalContact.astro';
import legal from '../data/legal.json';
import { isFinalDomain, missingLegalAddressFields, renderLegalBody } from '../utils/legal.mjs';
import { withBase } from '../utils/paths';
const body = renderLegalBody(legal.privacyBody, { withBase, youtubeAnchor: true });
const showDraftStatus = !(import.meta.env.PROD && isFinalDomain(process.env.SITE_URL)) && (missingLegalAddressFields(legal.provider).length > 0 || !legal.privacyReviewed);
---

<BaseLayout title="Datenschutz" description="Hinweise zum Datenschutz auf der Website von Hanna Zumsande.">
  <PageIntro label="Rechtliches" title="Datenschutz" />

  {showDraftStatus && <p class="notice"><strong>Vorläufiger Stand:</strong> Diese Hinweise müssen vor der Veröffentlichung unter Hannas Domain mit dem tatsächlichen Hosting und allen eingebundenen Diensten abgeglichen werden.</p>}

  <div class="content-grid">
    <aside class="content-aside">Datenschutzhinweise</aside>
    <article class="prose legal-prose">
      <LegalContact privacy />
      <Fragment set:html={body} />
    </article>
  </div>
</BaseLayout>
