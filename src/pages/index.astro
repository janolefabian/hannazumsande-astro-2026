---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventList from '../components/EventList.astro';
import SiteImage from '../components/SiteImage.astro';
import settings from '../data/settings.json';
import { biographyIntro, biographyHeading } from '../data/biography';
import { imageSettings } from '../data/images';
import { withBase } from '../utils/paths';

const today = new Date().toISOString().slice(0, 10);
const events = (await getCollection('termine', ({ data }) => data.published))
  .filter((event) => event.data.date.toISOString().slice(0, 10) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={settings.name} description={`${settings.name}, ${settings.role} aus Hamburg. Termine, Vita, Repertoire, Hörbeispiele und Kontakt.`} bodyClass="home-page">
  <section class="home-hero">
    <div class="home-hero__copy">
      <span class="hero-monogram" aria-hidden="true">HZ</span>
      <p class="section-label">{settings.role}</p>
      <h1><span>Hanna</span>{' '}<span>Zumsande</span></h1>
      <blockquote class="hero-quote">
        <p class="lead">„{settings.intro}“</p>
        {settings.quoteSource && <cite>{settings.quoteSource}</cite>}
      </blockquote>
      <div class="button-row">
        <a class="button" href={withBase('/termine/')}>Kalender ansehen</a>
      </div>
    </div>
    <figure class="home-hero__image">
      <SiteImage src={imageSettings.hero.src} alt={imageSettings.hero.alt} loading="eager" fetchpriority="high" />
      <figcaption>Foto {imageSettings.hero.credit}</figcaption>
    </figure>
  </section>

  <section class="home-block" aria-labelledby="naechste-auftritte">
    <div class="home-block__head">
      <h2 id="naechste-auftritte">Nächste Auftritte</h2>
      <a class="button" href={withBase('/termine/')}>Zum vollständigen Kalender</a>
    </div>
    {events.length > 0 ? <EventList events={events} compact /> : <p class="empty-state">Neue Termine folgen.</p>}
  </section>

  <section class="home-block home-profile">
    <SiteImage src={imageSettings.homePortrait.src} alt={imageSettings.homePortrait.alt} />
    <div class="home-profile__copy">
      <p class="section-label">Vita</p>
      <h2>{biographyHeading}</h2>
      <p class="large-copy">{biographyIntro}</p>
      <a class="button" href={withBase('/vita/')}>Vollständige Vita lesen</a>
    </div>
  </section>

  <section class="home-block" aria-labelledby="bereiche">
    <div class="home-block__head">
      <h2 id="bereiche">Mehr entdecken</h2>
    </div>
    <div class="home-discover">
      <a class="discover-row" href={withBase('/medien/')}>
        <SiteImage src={imageSettings.homeMedia.src} alt={imageSettings.homeMedia.alt} />
        <div><h3>Medien</h3><p>Audio und Video, Fotos, Diskografie, Downloads</p><span>Ansehen <span aria-hidden="true">↗</span></span></div>
      </a>
      <a class="discover-row" href={withBase('/kontakt/')}>
        <SiteImage src={imageSettings.homeContact.src} alt={imageSettings.homeContact.alt} />
        <div><h3>Kontakt</h3><p>Konzertanfragen und Agentur</p><span>Kontakt aufnehmen <span aria-hidden="true">↗</span></span></div>
      </a>
    </div>
  </section>
</BaseLayout>
