---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteImage from '../../components/SiteImage.astro';
import { gallery } from '../../data/images';
---

<BaseLayout title="Fotos" description="Ausgewählte Presse und Porträtfotos von Hanna Zumsande, Sopran.">
  <PageIntro
    label="Medien"
    title="Fotos"
    intro="Porträts und Pressefotos von Hanna Zumsande. Bitte bei Verwendung die jeweiligen Fotocredits angeben."
  />

  <div class="gallery-grid">
    {gallery.map((image) => (
      <figure>
        <a href={image.src} download><SiteImage src={image.src} alt={image.alt} /></a>
        <figcaption>Foto {image.credit}, zum Download auf das Bild klicken</figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>
