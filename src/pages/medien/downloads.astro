---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteImage from '../../components/SiteImage.astro';
import { pressPhotos } from '../../data/images';
import downloads from '../../data/downloads.json';
import { withBase } from '../../utils/paths';

const biographies = [
  { id: 'vita-long', label: 'Vita lang', src: downloads.vitaLong },
  { id: 'vita-short', label: 'Vita kurz', src: downloads.vitaShort },
];
---

<BaseLayout title="Downloads" description="Vita und Pressefotos von Hanna Zumsande, Sopran, zum Download.">
  <PageIntro
    label="Medien"
    title="Downloads"
    intro="Material für Veranstalter, Agenturen und Presse."
  />

  <div class="download-list">
    {pressPhotos.map((photo) => (
      <article class="download-card">
        <SiteImage src={photo.src} alt={photo.alt} />
        <h2>{photo.label}</h2>
        <p>Foto {photo.credit}</p>
        <a class="quiet-link" href={photo.src} download>Foto herunterladen</a>
      </article>
    ))}
    <article class="download-card download-card--vita">
      <h2>Vita als PDF</h2>
      <div class="vita-downloads">
        {biographies.map((biography) => biography.src ? (
          <a class="button" href={withBase(biography.src)} download>{biography.label}</a>
        ) : (
          <div>
            <button class="button" type="button" disabled aria-describedby={biography.id + '-status'}>{biography.label}</button>
            <p id={biography.id + '-status'} class="download-status">In Kürze verfügbar</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>
