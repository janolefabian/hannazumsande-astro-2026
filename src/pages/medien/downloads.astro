---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { imageSettings, pressPhotos } from '../../data/images';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Downloads" description="Vita und Pressefotos der Sopranistin Hanna Zumsande zum Download.">
  <PageIntro
    label="Medien"
    title="Downloads"
    intro="Material für Veranstalter, Agenturen und Presse."
  />

  <div class="download-list">
    {pressPhotos.map((photo) => (
      <article class="download-card">
        <img src={photo.src} alt={photo.alt} />
        <h2>{photo.label}</h2>
        <p>Foto {photo.credit}</p>
        <a class="quiet-link" href={photo.src} download>Foto herunterladen</a>
      </article>
    ))}
    <article class="download-card">
      <img src={withBase(imageSettings.documentPreview.src)} alt={imageSettings.documentPreview.alt} />
      <h2>Vita als PDF</h2>
      <p>Dokument aus der bisherigen Website</p>
      <a class="quiet-link" href={withBase('/downloads/vita-hanna-zumsande.pdf')}>PDF herunterladen</a>
    </article>
  </div>
</BaseLayout>
