---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteImage from '../../components/SiteImage.astro';
import VitaDownloads from '../../components/VitaDownloads.astro';
import { pressPhotos } from '../../data/images';
import { withBase } from '../../utils/paths';
---
<BaseLayout title="Downloads" description="Vita und Pressefotos von Hanna Zumsande, Sopran, zum Download." bodyClass="downloads-page">
  <PageIntro title="Downloads" compact />
  <div class="download-vita"><VitaDownloads shortFirst /></div>
  <div class="download-list">
    {pressPhotos.map(photo => (
      <figure class="download-card">
        <a href={withBase(photo.download || photo.src)} download aria-label={photo.alt + ', in hoher Auflösung herunterladen'}>
          <SiteImage src={photo.src} alt={photo.alt} />
        </a>
        <figcaption>Foto {photo.credit}<span>Zum Download auf das Bild klicken</span></figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>
