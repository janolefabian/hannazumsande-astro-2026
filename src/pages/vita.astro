---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SiteImage from '../components/SiteImage.astro';
import VitaDownloads from '../components/VitaDownloads.astro';
import { imageSettings } from '../data/images';
import { biographyParagraphs } from '../data/biography';
---
<BaseLayout title="Vita" description="Hanna Zumsande, Sopran aus Hamburg: Konzerttätigkeit, Aufnahmen und Lehre." bodyClass="vita-page">
  <PageIntro title="Vita" compact />
  <div class="vita-layout">
    <figure class="vita-photo">
      <SiteImage src={imageSettings.vitaPortrait.src} alt={imageSettings.vitaPortrait.alt} loading="eager" />
      <figcaption>Foto {imageSettings.vitaPortrait.credit}</figcaption>
    </figure>
    <article class="prose vita-prose">
      {biographyParagraphs.map(paragraph => <p>{paragraph}</p>)}
      <VitaDownloads />
    </article>
  </div>
</BaseLayout>
