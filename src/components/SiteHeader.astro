---
import settings from '../data/settings.json';
import { navigation } from '../data/site';
import { withBase } from '../utils/paths';

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const isActive = (href: string) => href === homeHref ? currentPath === homeHref : currentPath.startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href={homeHref} aria-label={`${settings.name}, Startseite`}>
    <span>{settings.name}</span>
    <small>{settings.role}</small>
  </a>

  <nav class="main-nav" aria-label="Hauptnavigation">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <button class="mobile-menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false" hidden>
    <span>Menü</span><span class="mobile-menu-icon" aria-hidden="true"></span>
  </button>

  <details class="mobile-nav" data-menu-fallback>
    <summary>Menü</summary>
    <nav aria-label="Mobile Navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Hauptmenü">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__head">
      <a class="mobile-menu__brand" href={homeHref}>
        <span>{settings.name}</span><small>{settings.role}</small>
      </a>
      <form method="dialog">
        <button class="mobile-menu__close" type="submit" autofocus>
          <span>Schließen</span><span class="mobile-menu-icon mobile-menu-icon--close" aria-hidden="true"></span>
        </button>
      </form>
    </div>
    <nav class="mobile-menu__links" aria-label="Mobile Navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</dialog>

<script>
  import { setupMobileMenu } from '../scripts/mobile-menu.js';
  setupMobileMenu();
</script>
