---
import settings from '../data/settings.json';
import { navigation } from '../data/site';
import { withBase } from '../utils/paths';

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const isActive = (href: string) => href === homeHref ? currentPath === homeHref : currentPath.startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href={homeHref} aria-label={`${settings.name}, Startseite`}>
    <span>{settings.name}</span>
    <small>{settings.role}</small>
  </a>

  <nav class="main-nav" aria-label="Hauptnavigation">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <details class="mobile-nav">
    <summary>Menü</summary>
    <nav aria-label="Mobile Navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>
