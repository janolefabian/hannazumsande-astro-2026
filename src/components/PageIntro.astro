---
import SiteImage from './SiteImage.astro';

interface Props {
  label?: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  imageCredit?: string;
  compact?: boolean;
}

const { label, title, intro, image, imageAlt = '', imageCredit, compact = false } = Astro.props;
---

<header class:list={['page-intro', { 'page-intro--image': image, 'page-intro--compact': compact }]}>
  <div class="page-intro__copy">
    {label && <p class="section-label">{label}</p>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
  {image && (
    <figure>
      <SiteImage src={image} alt={imageAlt} loading="eager" />
      {imageCredit && <figcaption>Foto {imageCredit}</figcaption>}
    </figure>
  )}
</header>
