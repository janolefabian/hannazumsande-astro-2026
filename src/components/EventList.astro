---
import type { CollectionEntry } from 'astro:content';
import { eventDetailPath, hasEventDetails } from '../utils/events';
import { withBase } from '../utils/paths';

interface Props {
  events: CollectionEntry<'termine'>[];
  compact?: boolean;
}

const { events, compact = false } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
---

<div class:list={['event-list', { 'event-list--compact': compact }]}>
  {events.map((event) => (
    <article class:list={['event-row', { 'event-row--linked': hasEventDetails(event) }]}>
      <time datetime={event.data.date.toISOString().slice(0, 10)}>
        <strong>{dateFormatter.format(event.data.date)}</strong>
        <span>{event.data.time}</span>
      </time>
      <div>
        <h2>
          {hasEventDetails(event) ? (
            <a class="event-link" href={withBase(eventDetailPath(event))}>{event.data.title}</a>
          ) : event.data.title}
        </h2>
        <p>{event.data.venue}{event.data.city ? `, ${event.data.city}` : ''}</p>
      </div>
      {hasEventDetails(event) && <span class="event-more" aria-hidden="true">Mehr erfahren <span>↗</span></span>}
    </article>
  ))}
</div>
